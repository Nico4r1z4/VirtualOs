# ======== VirtualOS — variables de entorno (api/) ========
# Copia este archivo a api/.env y llena los valores. NUNCA commitear .env.

APP_ENV=development
LOG_LEVEL=INFO

# Postgres de Supabase — usar SESSION POOLER (puerto 5432/6432), no el transaction pooler (6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Legacy JWT secret (Settings → API → JWT). Solo si el proyecto usa HS256; si no, se usa JWKS.
SUPABASE_JWT_SECRET=

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# IDs de modelo configurables (rápido = ganchos/agrupación, fuerte = ideas/mascota)
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-4-6
OPENAI_API_KEY=

# Apify
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=

# Noticias
SERPER_API_KEY=

# S3 opcional para crudos (si vacío, se guardan en api/.data/raw/)
S3_BUCKET=
AWS_REGION=us-east-1

# API
CORS_ORIGINS=http://localhost:5173

# ======== deploy/.env extra (solo en el servidor) ========
# DOMAIN=vos.orkiza.com
